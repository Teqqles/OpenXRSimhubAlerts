<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\ShmContract.cs" Link="ShmContract.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Preview cockpit background(s) embedded into the plugin DLL so the whole
         plugin ships as a single file (no loose assets to copy alongside it). -->
    <EmbeddedResource Include="ui\assets\*.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(SIMHUB)' != ''">
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SIMHUB)\SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SIMHUB)\GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SIMHUB)\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
